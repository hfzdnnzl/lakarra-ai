# Lakarra AI OS backend configuration (copy to .env and adjust).

# General
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Memory backend: in_memory (default, no DB) or postgres
MEMORY_BACKEND=in_memory
DATABASE_URL=postgresql+psycopg2://lakarra:lakarra@localhost:5432/lakarra

# Optional cache
# REDIS_URL=redis://localhost:6379/0

# LLM provider: mock (default), openai, anthropic, gemini
LLM_PROVIDER=mock
LLM_MODEL=mock-model
# Model name used by real providers (e.g. OpenAI). Read from MODEL_NAME.
MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Required when LLM_PROVIDER=openai:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Scheduler
SCHEDULER_ENABLED=false

# Video analysis for analytics upload review and published TikTok visual pass.
# auto (default) uses GEMINI_API_KEY when set, else OPENAI_API_KEY (samples frames
# via bundled ffmpeg from imageio-ffmpeg), else mock. Gemini watches the full video.
# Requires google-genai (supports AI Studio AQ. auth keys).
VIDEO_ANALYSIS_PROVIDER=auto
VIDEO_ANALYSIS_MODEL=gemini-2.0-flash

# TikTok account for Content Analyst (your @handle without @)
# Can also be set in the dashboard under Analytics → Connect Account
TIKTOK_ACCOUNT_HANDLE=

# TikTok data source: live (public data via tikwm.com) or mock (offline tests only)
TIKTOK_PROVIDER=live
# TIKTOK_API_BASE_URL=https://www.tikwm.com
# TIKTOK_MAX_VIDEOS=35
# TIKTOK_CACHE_TTL_SECONDS=60
# TIKTOK_RATE_LIMIT_RETRIES=3
# TIKTOK_RATE_LIMIT_RETRY_SECONDS=1.2
