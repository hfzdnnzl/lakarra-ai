# Lakarra AI OS backend configuration (copy to .env and adjust).

# General
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Memory backend: in_memory (default, no DB) or postgres
MEMORY_BACKEND=in_memory
DATABASE_URL=postgresql+psycopg2://lakarra:lakarra@localhost:5432/lakarra

# Optional cache
# REDIS_URL=redis://localhost:6379/0

# LLM provider: mock (default), openai, anthropic, gemini
LLM_PROVIDER=mock
LLM_MODEL=mock-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Scheduler
SCHEDULER_ENABLED=false
