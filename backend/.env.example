# Lakarra AI OS backend configuration (copy to .env and adjust).

# General
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Memory backend: in_memory (default, no DB) or postgres
MEMORY_BACKEND=in_memory
DATABASE_URL=postgresql+psycopg2://lakarra:lakarra@localhost:5432/lakarra

# Optional cache
# REDIS_URL=redis://localhost:6379/0

# LLM provider: mock (default), openai, anthropic, gemini
LLM_PROVIDER=mock
LLM_MODEL=mock-model
# Model name used by real providers (e.g. OpenAI). Read from MODEL_NAME.
MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Required when LLM_PROVIDER=openai:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Scheduler
SCHEDULER_ENABLED=false

# Video analysis for upload review (mock | gemini | openai)
VIDEO_ANALYSIS_PROVIDER=mock
VIDEO_ANALYSIS_MODEL=gemini-2.0-flash
